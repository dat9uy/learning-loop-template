{
  "version": 1,
  "hooks": {
    "recurrence-check-on-start": {
      "path": "tools/learning-loop-mastra/hooks/universal/recurrence-check-on-start.js",
      "event": "SessionStart",
      "wiring": {
        ".claude":     { "kind": "shim",   "ref": ".claude/coordination/hooks/recurrence-check-on-start.cjs" },
        ".hermes":     { "kind": "adapter", "ref": ".hermes/coordination/hooks/recurrence-check-on-start.cjs" }
      }
    },
    "session-start-inject-discoverability": {
      "path": "tools/learning-loop-mastra/hooks/universal/session-start-inject-discoverability.cjs",
      "event": "SessionStart",
      "wiring": {
        ".claude":     { "kind": "direct",  "ref": "node tools/learning-loop-mastra/hooks/universal/session-start-inject-discoverability.cjs" },
        ".hermes":     { "kind": "adapter", "ref": ".hermes/hooks/loop-surface-inject.cjs", "matcher": "first_turn" }
      }
    },
    "session-start-inject-process-hints": {
      "path": "tools/learning-loop-mastra/hooks/universal/session-start-inject-process-hints.cjs",
      "event": "SessionStart",
      "wiring": {
        ".claude":     { "kind": "direct",  "ref": "node tools/learning-loop-mastra/hooks/universal/session-start-inject-process-hints.cjs" },
        ".hermes":     { "kind": "adapter", "ref": ".hermes/hooks/loop-surface-inject.cjs", "matcher": "first_turn" }
      }
    },
    "session-start-git-push-preflight": {
      "path": "tools/learning-loop-mastra/hooks/universal/session-start-git-push-preflight.cjs",
      "event": "SessionStart",
      "wiring": {
        ".claude":     { "kind": "direct", "ref": "node tools/learning-loop-mastra/hooks/universal/session-start-git-push-preflight.cjs" },
        ".hermes":     { "kind": "none" }
      }
    },
    "session-start-git-merge-driver-preflight": {
      "path": "tools/learning-loop-mastra/hooks/universal/session-start-git-merge-driver-preflight.cjs",
      "event": "SessionStart",
      "wiring": {
        ".claude":     { "kind": "direct", "ref": "node tools/learning-loop-mastra/hooks/universal/session-start-git-merge-driver-preflight.cjs" },
        ".hermes":     { "kind": "none" }
      }
    },
    "bash-gate": {
      "path": "tools/learning-loop-mastra/hooks/universal/bash-gate.js",
      "event": "PreToolUse",
      "wiring": {
        ".claude":     { "kind": "shim",   "ref": ".claude/coordination/hooks/bash-coordination-gate.cjs",     "matcher": "Bash" },
        ".hermes":     { "kind": "adapter", "ref": ".hermes/coordination/hooks/bash-coordination-gate.cjs", "matcher": "terminal" }
      }
    },
    "write-gate": {
      "path": "tools/learning-loop-mastra/hooks/universal/write-gate.js",
      "event": "PreToolUse",
      "wiring": {
        ".claude":     { "kind": "shim",   "ref": ".claude/coordination/hooks/write-coordination-gate.cjs",    "matcher": "Edit|Write" },
        ".hermes":     { "kind": "adapter", "ref": ".hermes/coordination/hooks/write-coordination-gate.cjs", "matcher": "write_file|patch" }
      }
    },
    "inbound-gate": {
      "path": "tools/learning-loop-mastra/hooks/universal/inbound-gate.js",
      "event": "UserPromptSubmit",
      "wiring": {
        ".claude":     { "kind": "shim",   "ref": ".claude/coordination/hooks/inbound-state-gate.cjs" },
        ".hermes":     { "kind": "adapter", "ref": ".hermes/coordination/hooks/inbound-state-gate.cjs" }
      }
    },
    "toolchain-failure-capture": {
      "path": "tools/learning-loop-mastra/hooks/universal/toolchain-failure-capture.js",
      "event": "PostToolUseFailure",
      "wiring": {
        ".claude":     { "kind": "shim",   "ref": ".claude/coordination/hooks/toolchain-failure-capture.cjs" },
        ".hermes":     { "kind": "adapter", "ref": ".hermes/coordination/hooks/toolchain-failure-capture.cjs", "matcher": "terminal" }
      }
    }
  }
}
