{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

  "entry": [
    "mastra/server.js",
    "mastra/create-loop-tool.js",
    "mastra/create-loop-workflow.js",
    "mastra/create-loop-agent.js",
    "mastra/handler-adapter.js",
    "mastra/agents/load-agents-manifest.js",
    "mastra/schemas.js",
    "core/schema-parity.js",
    "storage.js",
    "scripts/**",
    "bin/loop.mjs",
    "core/hint-renderer.js",
    "hooks/commit-msg-stable-artifacts.js"
  ],

  "dynamicallyLoaded": [
    "tools/handlers/**/*.js",
    "hooks/universal/**/*.js",
    "hooks/universal/**/*.cjs",
    "interface/**/*.js",
    "__tests__/with-mcp-server.js",
    "__tests__/helpers/**/*.cjs",
    "__tests__/banner-budget.js",
    "core/cli-context-savings.js",
    "tools/lib/patch-hints.js"
  ],

  "ignorePatterns": [
    "__tests__/fixtures/**",
    "__tests__/phase-e-foundation/fixtures/**",
    "tools/handlers/evals/**",
    "tools/handlers/references/**",
    "tools/handlers/fixtures/**",
    "tools/handlers/scripts/**",
    "plans/**",
    "docs/**",
    "**/*.test.js",
    "**/*.test.cjs",
    "**/*.spec.js",
    "**/*.spec.cjs"
  ],

  "ignoreExports": [
    {
      "file": "core/gate-logic.js",
      "exports": [
        "stripHeredocBodies",
        "safeStripHeredocBodies",
        "splitSegments",
        "stripMessageFlags",
        "stripNodeEvalBody",
        "stripDataCommandQuotes",
        "stripEchoProse",
        "BLANKABLE_HEREDOC_VERBS_PROMOTED",
        "stripCliArgvPayload",
        "applyInertSinkBlanking"
      ]
    },
    {
      "file": "core/blanking.js",
      "exports": [
        "splitSegments",
        "stripMessageFlags",
        "stripNodeEvalBody",
        "stripDataCommandQuotes",
        "stripEchoProse",
        "BLANKABLE_HEREDOC_VERBS_PROMOTED",
        "BLANKABLE_HEREDOC_VERBS_CONSTRAINT",
        "BLANKABLE_HEREDOC_VERBS_GATEVERB",
        "stripHeredocBodies",
        "safeStripHeredocBodies",
        "stripCliArgvPayload",
        "applyInertSinkBlanking"
      ]
    },
    {
      "file": "core/command-classification.js",
      "exports": [
        "CLASSIFIER_MODES"
      ]
    },
    {
      "file": "core/gate-decision-log.js",
      "exports": [
        "readDecisionLog"
      ]
    },
    {
      "file": "core/recurrence-tracker.js",
      "exports": [
        "normalizePrefixForKey",
        "blankDataPayloadsForKey"
      ]
    },
    {
      "file": "core/runtime-state.js",
      "exports": [
        "readRuntimeStateRowsForFile",
        "RUNTIME_STATE_LOCAL_FILENAME"
      ]
    },
    {
      "file": "core/meta-state.js",
      "exports": [
        "FILE_INDEX_FILENAME",
        "getFileIndexPath",
        "_resetFileIndexCacheForTests"
      ]
    },
    {
      "file": "core/entry/relationship-graph.js",
      "exports": [
        "parseConsolidates",
        "inboundFromLoopDesign",
        "_internal"
      ]
    },
    {
      "file": "core/cli-self-match.js",
      "exports": [
        "CLI_INVOCATION_SHAPES"
      ]
    },
    {
      "file": "tools/lib/gate-logging.js",
      "exports": [
        "appendGateLog",
        "logToolCall"
      ]
    },
    {
      "file": "core/gate-logging.js",
      "exports": [
        "appendGateLog",
        "logToolCall"
      ]
    },
    {
      "file": "tools/lib/patch-hints.js",
      "exports": [
        "listMutableFieldsCsv"
      ]
    },
    {
      "file": "core/canonical-compare.js",
      "exports": [
        "canonicalize"
      ]
    },
    {
      "file": "core/check-grounding.js",
      "exports": [
        "META_STATE_GROUNDING_STATUSES",
        "META_STATE_GROUNDING_DRIFT_KINDS",
        "FileNotFoundError"
      ]
    },
    {
      "file": "core/consistency-check.js",
      "exports": [
