        "computeFingerprint",
        "assertKindConditionalStatus"
      ]
    },
    {
      "file": "core/shell-parse.js",
      "exports": [
        "parse"
      ]
    },
    {
      "file": "core/evaluate-write-gate.js",
      "exports": [
        "evaluatePreflight"
      ]
    },
    {
      "file": "core/evaluate-bash-gate.js",
      "exports": [
        "DECISION_LOG_WRITE_PATTERNS",
        "PATH_WRITE_PATTERNS",
        "DECISION_LOG_WRITE_REASON"
      ]
    },
    {
      "file": "core/identity-pin.js",
      "exports": [
